# Feature flag. The ordinary PL_8 page is used unless this is exactly "true".
TDS_ENABLED=false

# Fixed, server-side campaign destination and its exact allowed hostname.
TDS_TARGET_URL=
TDS_ALLOWED_TARGET_HOSTS=
TDS_CORRELATION_PARAM=sub_id_6

# Optional signed server-to-server event. It never blocks the visitor redirect.
TDS_EVENT_URL=
TDS_SHARED_SECRET=
TDS_KEY_ID=
TDS_SITE_ID=PL_8
TDS_TIMEOUT_MS=900
